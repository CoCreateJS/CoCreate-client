    "@cocreate/crdt": "^2.0.1",
    "@cocreate/crud": "^0.0.0-stage",
    "@cocreate/css-parser": "^2.0.0",
    "@cocreate/cursors": "^2.0.1",
    "@cocreate/element-prototype": "^2.0.1",
